<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4A4A6A"
    android:backgroundTint="@color/black"
    android:padding="16dp">

    <!-- Back Arrow -->
    <ImageView
        android:id="@+id/backArrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_back_arrow"
        android:layout_alignParentStart="true"
        android:layout_marginTop="10dp" />

    <!-- Playlist Title -->
    <TextView
        android:id="@+id/playlistText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PLAYING FROM PLAYLIST"
        android:textColor="#CCCCCC"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:textSize="12sp" />

    <!-- Playlist Name -->
    <TextView
        android:id="@+id/playlistName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ali Zafar Mix"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_below="@id/playlistText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="5dp" />

    <!-- Options Button -->
    <ImageView
        android:id="@+id/optionsButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_dots"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="10dp" />

    <!-- Album Art -->
    <ImageView
        android:id="@+id/albumArt"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        android:src="@drawable/ali_zafar"
        android:scaleType="fitCenter" />

    <!-- Song Title -->
    <TextView
        android:id="@+id/songTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saajna"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_below="@id/albumArt"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp" />

    <!-- Artist Name -->
    <TextView
        android:id="@+id/artistName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Falak Shabbir"
        android:textColor="#B3B3B3"
        android:textSize="16sp"
        android:layout_below="@id/songTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="5dp" />

    <!-- Like and Dislike Buttons -->
    <LinearLayout
        android:id="@+id/likeDislikeButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/artistName"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/dislikeButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_disturb" />

        <ImageView
            android:id="@+id/likeButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_circle_add"
            android:layout_marginStart="20dp" />
    </LinearLayout>

    <!-- SeekBar -->
    <SeekBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/likeDislikeButtons"
        android:layout_marginTop="20dp"
        android:thumbTint="#FFFFFF" />

    <!-- Time Labels -->
    <LinearLayout
        android:id="@+id/timeLabels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/progressBar"
        android:layout_marginTop="5dp"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/startTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#B3B3B3"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/endTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4:42"
            android:textColor="#B3B3B3"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Player Controls -->
    <LinearLayout
        android:id="@+id/playerControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/timeLabels"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/prevButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_previous" />

        <ImageView
            android:id="@+id/playPauseButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_pause"
            android:layout_marginHorizontal="20dp" />

        <ImageView
            android:id="@+id/nextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_next" />
    </LinearLayout>

    <!-- Additional Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/playerControls"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/deviceButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_devices" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/shareButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/ic_share" />
        <ImageView
            android:id="@+id/queueButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_queue" />
    </LinearLayout>

</RelativeLayout>
